# Copia este archivo a `.env.local` (no versionado) para sobrescribir valores locales.
#
# VITE_AUTH_SIMULADA
#   true  -> autenticación simulada: cuenta demo y proveedores de ejemplo (solo demo/desarrollo).
#   false -> sin simulación: el ingreso falla con el error genérico hasta que exista backend real.
#            Con false las credenciales demo NO quedan en el bundle de producción.
# Nota: toda variable VITE_* es pública; nunca pongas secretos aquí (Const. A1).
VITE_AUTH_SIMULADA=true
